+/// Expand zero-width (`start == end`) or newline-only diagnostic ranges to the
+/// nearest token so syntax/EOF diagnostics (e.g. `rust-analyzer`'s
+/// `Syntax Error: expected an item` at the end of a bare identifier or `<eof>`)
+/// produce a visible wavy underline and hover target.
+fn resolve_diagnostic_byte_range(text: &Rope, range: &Range<Position>) -> Range<usize> {
+    let start = text.position_to_offset(&range.start);
+    let end = text.position_to_offset(&range.end);
+
+    if start < end {
+        let has_visible = text
+            .slice(start..end)
+            .chars()
+            .any(|c| c != '\n' && c != '\r');
+        if has_visible {
+            return start..end;
+        }
+    }
+
+    let line_count = text.lines_len();
+    if line_count == 0 {
+        return start..end;
+    }
+
+    let target_line = (range.start.line as usize).min(line_count.saturating_sub(1));
+    let line_start = text.line_start_offset(target_line);
+    let line_end = text.line_end_offset(target_line);
+    let line_str = text.slice(line_start..line_end).to_string();
+
+    if !line_str.trim().is_empty() {
+        let rel = start.saturating_sub(line_start).min(line_str.len());
+        if let Some(span) = token_span_before(&line_str[..rel]) {
+            return (line_start + span.start)..(line_start + span.end);
+        }
+        if let Some(span) = token_span_after(&line_str[rel..]) {
+            return (line_start + rel + span.start)..(line_start + rel + span.end);
+        }
+    }
+
+    for prev_line in (0..target_line).rev() {
+        let p_start = text.line_start_offset(prev_line);
+        let p_end = text.line_end_offset(prev_line);
+        let p_str = text.slice(p_start..p_end).to_string();
+        if let Some(span) = token_span_before(&p_str) {
+            return (p_start + span.start)..(p_start + span.end);
+        }
+    }
+
+    for next_line in (target_line + 1)..line_count {
+        let n_start = text.line_start_offset(next_line);
+        let n_end = text.line_end_offset(next_line);
+        let n_str = text.slice(n_start..n_end).to_string();
+        if let Some(span) = token_span_after(&n_str) {
+            return (n_start + span.start)..(n_start + span.end);
+        }
+    }
