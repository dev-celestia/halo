+
+/// True when the code-block style asks to sit flush in a parent surface (hover /
+/// diagnostic popovers set a transparent background + zero padding).
+fn code_block_is_bare(code_block: &StyleRefinement) -> bool {
+    code_block
+        .background
+        .as_ref()
+        .and_then(|fill| fill.color())
+        .is_some_and(|color| color.is_transparent())
+}
 
