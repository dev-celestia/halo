+
+/// Include LSP `code` / `source` so rustc ids like `E0425` show in the editor popover.
+fn format_diagnostic_markdown(diagnostic: &DiagnosticEntry) -> String {
+    let code = diagnostic.code.as_ref().filter(|c| !c.is_empty());
+    let source = diagnostic.source.as_ref().filter(|s| !s.is_empty());
+
+    let mut body = String::new();
+    if let Some(code) = code {
+        body.push('`');
+        body.push_str(code);
+        body.push_str("` ");
+    }
+    body.push_str(diagnostic.message.as_ref());
+    if let Some(source) = source {
+        body.push_str("\n\n");
+        body.push_str(source);
+    }
+    body
+}
